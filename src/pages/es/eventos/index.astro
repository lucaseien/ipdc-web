---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import EventCard from '@/components/EventCard.astro';
import PostCard from '@/components/PostCard.astro';
import Button from '@/components/Button.astro';
import { eventUrl, getEvents, getPage, getPosts, postUrl } from '@/lib/content';

const page = await getPage('eventos');
const { upcoming, past } = await getEvents('es');
const news = (await getPosts('es', 'noticias-y-eventos')).slice(0, 3);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <PageHeader title={page.data.title} breadcrumbs={[{ label: 'Inicio', href: '/es/' }, { label: page.data.title }]} />

  <div class="container-page space-y-20 py-16 sm:py-20">
    <section aria-labelledby="proximos">
      <SectionHeading id="proximos" title="Próximos eventos" />
      {
        upcoming.length ? (
          <ul class="grid max-w-4xl gap-6">
            {upcoming.map((e) => (
              <li>
                <EventCard title={e.data.title} href={eventUrl(e)} startDate={e.data.startDate} endDate={e.data.endDate} location={e.data.location} modality={e.data.modality} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="max-w-(--container-prose) rounded-card border border-dashed border-linea p-6 text-tinta-2">
            No hay eventos programados por el momento. Las próximas actividades se anuncian en el{' '}
            <a href="/es/blog/categoria/noticias-y-eventos/">blog</a> y en las redes sociales del IDSP.
          </p>
        )
      }
    </section>

    {
      past.length > 0 && (
        <section aria-labelledby="anteriores">
          <SectionHeading id="anteriores" title="Eventos anteriores" />
          <ul class="grid max-w-4xl gap-6">
            {past.map((e) => (
              <li>
                <EventCard title={e.data.title} href={eventUrl(e)} startDate={e.data.startDate} endDate={e.data.endDate} location={e.data.location} modality={e.data.modality} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      news.length > 0 && (
        <section aria-labelledby="noticias">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <SectionHeading id="noticias" eyebrow="Blog" title="Noticias y eventos" />
            <p class="mb-8 sm:mb-10">
              <Button href="/es/blog/categoria/noticias-y-eventos/" variant="link" arrow>Ver todas</Button>
            </p>
          </div>
          <ul class="grid gap-12 md:grid-cols-2 lg:grid-cols-3 lg:gap-10">
            {news.map((p) => (
              <li>
                <PostCard title={p.data.title} href={postUrl(p)} date={p.data.date} authors={p.data.authors} excerpt={p.data.description} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
