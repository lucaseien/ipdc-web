---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import { getPage } from '@/lib/content';
import { membershipHref } from '@/config/site';
import foto from '@/assets/fotos/catedral.jpg';

const page = await getPage('miembros');
const requisitos = await getPage('requisitos-miembro');
const { Content } = await render(page);
const { Content: Requisitos } = await render(requisitos);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <PageHeader
    eyebrow="El Instituto"
    title={page.data.title}
    lead={page.data.lead}
    image={foto}
    imageAlt="Catedral Metropolitana de Asunción reflejada en un charco tras la lluvia"
    breadcrumbs={[{ label: 'Inicio', href: '/es/' }, { label: 'El Instituto', href: '/es/instituto/' }, { label: page.data.title }]}
  />

  <div class="container-page py-16 sm:py-20">
    <div class="prose-site mb-14"><Content /></div>

    <section id="requisitos" aria-labelledby="requisitos-titulo" class="scroll-mt-28 rounded-card border border-linea bg-white p-6 sm:p-10 lg:p-12">
      <SectionHeading id="requisitos-titulo" eyebrow="Cómo ser miembro" title={requisitos.data.title} />
      <div class="prose-site"><Requisitos /></div>
      <p class="mt-10"><Button href={membershipHref} arrow>Quiero ser miembro</Button></p>
    </section>
  </div>
</BaseLayout>
