---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import PostCard from '@/components/PostCard.astro';
import EventCard from '@/components/EventCard.astro';
import Icon from '@/components/Icon.astro';
import OrganizationSchema from '@/components/OrganizationSchema.astro';
import { categories, eventUrl, getEvents, getPage, getPosts, postUrl } from '@/lib/content';
import { membershipHref, usefulLinks } from '@/config/site';
import cabildo from '@/assets/fotos/cabildo.jpg';

const page = await getPage('inicio');
const { Content } = await render(page);
const requisitos = await getPage('requisitos-miembro');
const { Content: Requisitos } = await render(requisitos);
const posts = (await getPosts('es')).slice(0, 3);
const { upcoming, past } = await getEvents('es');
const featuredEvents = upcoming.length ? upcoming.slice(0, 2) : past.slice(0, 1);

// Qué ofrecemos: textos tomados de la página "Qué ofrecemos"
const highlights = [
  {
    title: 'Capacitación',
    text: 'Cursos de formación en Derecho de Seguros, como el Diplomado que se dicta en coordinación con la Universidad Católica.',
    href: '/es/instituto/que-hacemos/#capacitacion',
  },
  {
    title: 'Charlas',
    text: 'Charlas formativas sobre diferentes temas del Derecho de Seguros.',
    href: '/es/instituto/que-hacemos/#charlas',
  },
  {
    title: 'Dictámenes',
    text: 'Dictámenes con respecto a proyectos o modificaciones de disposiciones legales que hacen a esta rama del Derecho.',
    href: '/es/instituto/que-hacemos/#dictamenes',
  },
];
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <OrganizationSchema slot="head" />

  <!-- Portada -->
  <section class="on-dark relative isolate overflow-hidden bg-azul-950 text-white">
    <Image
      src={cabildo}
      alt="Fachada del Cabildo de Asunción al atardecer"
      widths={[640, 960, 1440, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 size-full object-cover object-[70%_center]"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-azul-950 via-azul-950/80 to-azul-950/25 lg:bg-gradient-to-r lg:from-azul-950/95 lg:via-azul-950/70 lg:to-transparent"></div>
    <div class="container-page flex min-h-[34rem] flex-col justify-end pt-28 pb-14 sm:min-h-[38rem] lg:min-h-[42rem] lg:justify-center lg:pb-24">
      <div class="max-w-3xl">
        <h1 class="text-display font-medium text-white">{page.data.title}</h1>
        <span class="filete mt-7" aria-hidden="true"></span>
        <p class="mt-7 max-w-2xl text-lead text-azul-100">{page.data.lead}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <Button href="/es/instituto/" variant="inverse" arrow>Conocer más</Button>
          <a
            href={membershipHref}
            class="inline-flex min-h-12 items-center rounded-card border border-white/40 px-5 font-semibold text-white no-underline hover:border-white hover:bg-white/10 hover:text-white"
          >
            Quiero ser miembro
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Presentación -->
  <section class="container-page grid gap-10 py-20 sm:py-24 lg:grid-cols-12 lg:gap-16" aria-labelledby="presentacion">
    <div class="lg:col-span-5">
      <p class="label mb-3">El Instituto</p>
      <h2 id="presentacion" class="text-h2 font-medium">¿Quiénes somos?</h2>
      <span class="filete mt-5" aria-hidden="true"></span>
    </div>
    <div class="lg:col-span-7">
      <div class="prose-site">
        <Content />
      </div>
      <p class="mt-8">
        <Button href="/es/instituto/" variant="link" arrow>Conocer más</Button>
      </p>
    </div>
  </section>

  <!-- Accesos -->
  <section class="border-y border-linea bg-papel-2" aria-labelledby="ofrecemos">
    <h2 id="ofrecemos" class="sr-only">Qué ofrecemos</h2>
    <ul class="container-page grid gap-px py-0 sm:grid-cols-3">
      {
        highlights.map((h) => (
          <li class="group relative py-10 sm:px-8 sm:first:pl-0 sm:last:pr-0 sm:[&+&]:border-l sm:[&+&]:border-linea">
            <h3 class="font-serif text-h3 font-semibold text-azul-900">
              <a href={h.href} class="no-underline after:absolute after:inset-0 group-hover:underline">{h.title}</a>
            </h3>
            <p class="mt-3 text-tinta-2">{h.text}</p>
            <Icon name="arrow-right" class="mt-5 size-5 text-celeste-600 transition-transform group-hover:translate-x-1" />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Ser miembro -->
  <section class="container-page grid gap-10 py-20 sm:py-24 lg:grid-cols-12 lg:gap-16" aria-labelledby="requisitos-home">
    <div class="lg:col-span-5">
      <p class="label mb-3">Ser miembro</p>
      <h2 id="requisitos-home" class="text-h2 font-medium">{requisitos.data.title}</h2>
      <span class="filete mt-5" aria-hidden="true"></span>
    </div>
    <div class="lg:col-span-7">
      <div class="prose-site"><Requisitos /></div>
      <p class="mt-8"><Button href={membershipHref} arrow>Quiero ser miembro</Button></p>
    </div>
  </section>

  <!-- Blog (solo si hay entradas) -->
  {posts.length > 0 && (
  <section class="container-page py-20 sm:py-24" aria-labelledby="blog-home">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading id="blog-home" eyebrow="Blog" title="Últimas entradas" />
      <p class="mb-8 sm:mb-10"><Button href="/es/blog/" variant="link" arrow>Ver todas las entradas</Button></p>
    </div>
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-3 lg:gap-10">
      {
        posts.map((p) => (
          <PostCard
            title={p.data.title}
            href={postUrl(p)}
            date={p.data.date}
            authors={p.data.authors}
            category={categories[p.data.category]}
            excerpt={p.data.description}
          />
        ))
      }
    </div>
  </section>
  )}

  <!-- Eventos (solo si hay) -->
  {featuredEvents.length > 0 && (
  <section class="border-t border-linea bg-white py-20 sm:py-24" aria-labelledby="eventos-home">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeading id="eventos-home" eyebrow="Eventos" title={upcoming.length ? 'Próximos eventos' : 'Eventos anteriores'} />
        <p class="mb-8 sm:mb-10"><Button href="/es/eventos/" variant="link" arrow>Ver eventos</Button></p>
      </div>
      <div class="grid max-w-4xl gap-6">
        {
          featuredEvents.map((e) => (
            <EventCard
              title={e.data.title}
              href={eventUrl(e)}
              startDate={e.data.startDate}
              endDate={e.data.endDate}
              location={e.data.location}
              modality={e.data.modality}
            />
          ))
        }
      </div>
    </div>
  </section>
  )}

  <!-- Enlaces de interés -->
  <section class="border-t border-linea bg-white py-16 sm:py-20" aria-labelledby="enlaces">
    <div class="container-page">
      <SectionHeading id="enlaces" title="Enlaces de interés" />
      <ul class="grid gap-4 sm:grid-cols-3">
        {
          usefulLinks.map((l) => (
            <li>
              <a
                href={l.href}
                rel="noopener"
                class="group flex h-full items-center justify-between gap-4 rounded-card border border-linea bg-papel p-5 font-semibold text-azul-900 no-underline hover:border-azul-700"
              >
                <span class="group-hover:underline">{l.name}</span>
                <Icon name="external" class="size-5 text-celeste-700" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
