---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import DocumentCard from '@/components/DocumentCard.astro';
import Button from '@/components/Button.astro';
import { getPage } from '@/lib/content';
import foto from '@/assets/fotos/panteon.jpg';

const page = await getPage('constitucion-1992');
const { Content } = await render(page);
const docs = (await getCollection('documentos', (d) => d.data.group === 'constitucion-1992')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <PageHeader
    eyebrow="Constitución"
    title={page.data.title}
    lead={page.data.lead}
    image={foto}
    imageAlt="Cúpula del Panteón Nacional de los Héroes, en Asunción, al anochecer"
    breadcrumbs={[{ label: 'Inicio', href: '/es/' }, { label: 'Constitución' }, { label: page.data.title }]}
  />

  <div class="container-page grid gap-14 py-16 sm:py-20 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <div class="prose-ipdc"><Content /></div>
    </div>
    <aside class="lg:col-span-5" aria-labelledby="documentos">
      <div class="lg:sticky lg:top-28">
        <SectionHeading id="documentos" title="Documentos" as="h2" />
        <ul class="space-y-4">
          {
            docs.map((d) => (
              <li>
                <DocumentCard
                  title={d.data.title}
                  description={d.data.description}
                  href={d.data.file ?? d.data.url}
                  docLang={d.data.lang}
                  year={d.data.year}
                  available={!!(d.data.file || d.data.url)}
                />
              </li>
            ))
          }
        </ul>
        <p class="mt-8"><Button href="/es/constitucion/historicas/" variant="link" arrow>Constituciones y documentos políticos anteriores</Button></p>
      </div>
    </aside>
  </div>
</BaseLayout>
