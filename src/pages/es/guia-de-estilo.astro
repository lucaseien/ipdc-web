---
/**
 * Guía de estilo interna (noindex, excluida del sitemap).
 * Muestra el sistema de diseño con contenido real del IPDC.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import DocumentCard from '@/components/DocumentCard.astro';
import PersonCard from '@/components/PersonCard.astro';
import PostCard from '@/components/PostCard.astro';
import EventCard from '@/components/EventCard.astro';
import Accordion from '@/components/Accordion.astro';
import Callout from '@/components/Callout.astro';
import Pagination from '@/components/Pagination.astro';
import Newsletter from '@/components/Newsletter.astro';
import Logo from '@/components/Logo.astro';
import panteon from '@/assets/fotos/panteon.jpg';
import robert from '@/assets/autores/robert-marcial-gonzalez.png';

const colors = [
  { group: 'Azul institucional', items: [
    ['azul-950', '#0C1636', 'Footer, fondos oscuros'],
    ['azul-900', '#10204F', 'Títulos'],
    ['azul-700', '#193389', 'Logo · enlaces · botones'],
    ['azul-600', '#2845A6', 'Foco de teclado'],
    ['azul-200', '#C9D3EE', 'Texto sobre azul oscuro'],
    ['azul-100', '#E7ECF8', 'Fondos suaves'],
    ['azul-50', '#F3F5FB', 'Notas, hover'],
  ] },
  { group: 'Rojo (acento)', items: [
    ['rojo-700', '#A8172A', 'Rótulos pequeños'],
    ['rojo-600', '#C71B2E', 'Logo · filetes · viñetas'],
    ['rojo-100', '#FBE7E9', 'Fondo de avisos'],
  ] },
  { group: 'Papel y tinta', items: [
    ['tinta', '#1C1E26', 'Texto principal'],
    ['tinta-2', '#4A4C55', 'Texto secundario'],
    ['tinta-3', '#62636B', 'Metadatos'],
    ['linea', '#E2DDD3', 'Bordes y divisores'],
    ['papel-2', '#F3EFE7', 'Cabeceras claras'],
    ['papel', '#FAF8F4', 'Fondo del sitio'],
  ] },
];

const contrast = [
  ['Texto principal (tinta) sobre papel', '15,7:1'],
  ['Texto secundario (tinta-2) sobre papel', '8,1:1'],
  ['Metadatos (tinta-3) sobre papel', '5,6:1'],
  ['Enlace (azul-700) sobre papel', '10,6:1'],
  ['Rótulo (rojo-700) sobre papel', '7,0:1'],
  ['Blanco sobre azul-700 (botón)', '11,2:1'],
  ['azul-200 sobre azul-950 (footer)', '11,9:1'],
];
---

<BaseLayout title="Guía de estilo" description="Sistema de diseño del sitio del IPDC." noindex>
  <PageHeader
    eyebrow="Sistema de diseño"
    title="Guía de estilo del IPDC"
    lead="Colores, tipografía y componentes del nuevo sitio. Esta página es interna: no se indexa ni aparece en el menú."
    breadcrumbs={[{ label: 'Inicio', href: '/es/' }, { label: 'Guía de estilo' }]}
  />

  <div class="container-page space-y-24 py-16 sm:py-20">
    <!-- Marca -->
    <section aria-labelledby="marca">
      <SectionHeading id="marca" eyebrow="01" title="Marca" />
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="flex min-h-40 items-center justify-center rounded-card border border-linea bg-white p-8"><Logo /></div>
        <div class="flex min-h-40 items-center justify-center rounded-card bg-azul-950 p-8"><Logo tone="dark" /></div>
      </div>
      <p class="mt-4 max-w-(--container-prose) text-small text-tinta-2">
        Logo redibujado en SVG (8 KB) a partir del PNG de 512 px: el anillo y las seis cabezas son geometría exacta y las letras
        "IPDC" fueron redibujadas. Colores medidos del original: rojo <code>#C71B2E</code> y azul <code>#193389</code>. El filete
        bicolor retoma los bloques rojo y azul del banner institucional.
      </p>
    </section>

    <!-- Color -->
    <section aria-labelledby="color">
      <SectionHeading id="color" eyebrow="02" title="Color" />
      <div class="space-y-10">
        {
          colors.map((g) => (
            <div>
              <h3 class="mb-4 font-sans text-small font-semibold text-tinta-2">{g.group}</h3>
              <ul class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
                {g.items.map(([name, hex, use]) => (
                  <li class="overflow-hidden rounded-card border border-linea bg-white">
                    <span class="block h-16" style={`background:${hex}`} />
                    <span class="block p-3 text-label">
                      <strong class="block text-small text-tinta">{name}</strong>
                      <code class="text-tinta-3">{hex}</code>
                      <span class="mt-1 block text-tinta-2">{use}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <h3 class="mt-12 mb-4 font-sans text-small font-semibold text-tinta-2">Contraste (WCAG 2.1 AA exige 4,5:1)</h3>
      <table class="w-full max-w-2xl text-small">
        <tbody>
          {
            contrast.map(([pair, ratio]) => (
              <tr class="border-b border-linea">
                <td class="py-2 pr-4">{pair}</td>
                <td class="py-2 text-right font-semibold whitespace-nowrap text-azul-700">{ratio} ✓</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <!-- Tipografía -->
    <section aria-labelledby="tipografia">
      <SectionHeading id="tipografia" eyebrow="03" title="Tipografía" />
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <p class="label mb-2 text-tinta-3">Títulos · Newsreader</p>
          <p class="font-serif text-display font-medium text-azul-900">Democracia constitucional</p>
          <p class="mt-3 text-small text-tinta-2">
            Serif editorial con ejes variables de peso y tamaño óptico: se afina sola en títulos grandes y gana robustez en
            tamaños chicos. Soporta todos los acentos del español y del guaraní (ã, ẽ, ĩ, õ, ũ, ỹ, g̃).
          </p>
        </div>
        <div>
          <p class="label mb-2 text-tinta-3">Texto · Source Sans 3</p>
          <p class="text-lead text-tinta">
            Sans-serif humanista diseñada para lectura en pantalla: letras abiertas y buena legibilidad en celulares.
          </p>
          <p class="mt-3 text-small text-tinta-2">
            Ambas son de código abierto y se sirven desde el propio sitio (sin Google Fonts), con solo los subconjuntos de caracteres necesarios.
          </p>
        </div>
      </div>

      <dl class="mt-12 divide-y divide-linea border-y border-linea">
        <div class="grid gap-2 py-5 sm:grid-cols-[10rem_1fr] sm:items-baseline">
          <dt class="text-label text-tinta-3">Display · 38–64 px</dt>
          <dd class="font-serif text-display font-medium text-azul-900">Instituto Paraguayo</dd>
        </div>
        <div class="grid gap-2 py-5 sm:grid-cols-[10rem_1fr] sm:items-baseline">
          <dt class="text-label text-tinta-3">H1 · 34–52 px</dt>
          <dd class="font-serif text-h1 font-medium text-azul-900">Constitución de 1992</dd>
        </div>
        <div class="grid gap-2 py-5 sm:grid-cols-[10rem_1fr] sm:items-baseline">
          <dt class="text-label text-tinta-3">H2 · 26–36 px</dt>
          <dd class="font-serif text-h2 font-medium text-azul-900">Comisión Directiva (2025-2028)</dd>
        </div>
        <div class="grid gap-2 py-5 sm:grid-cols-[10rem_1fr] sm:items-baseline">
          <dt class="text-label text-tinta-3">H3 · 20–24 px</dt>
          <dd class="font-serif text-h3 font-semibold text-azul-900">Capítulo paraguayo del IIDC</dd>
        </div>
        <div class="grid gap-2 py-5 sm:grid-cols-[10rem_1fr] sm:items-baseline">
          <dt class="text-label text-tinta-3">Lead · 19–22 px</dt>
          <dd class="text-lead text-tinta-2">Trabajamos para promover el conocimiento y el intercambio de ideas sobre el derecho constitucional.</dd>
        </div>
        <div class="grid gap-2 py-5 sm:grid-cols-[10rem_1fr] sm:items-baseline">
          <dt class="text-label text-tinta-3">Texto · 17–18 px / 1,7</dt>
          <dd class="max-w-(--container-prose)">
            La Constitución dispone que el Paraguay se constituye en un Estado social de derecho y que adopta para su gobierno la
            democracia representativa, participativa y pluralista.
          </dd>
        </div>
        <div class="grid gap-2 py-5 sm:grid-cols-[10rem_1fr] sm:items-baseline">
          <dt class="text-label text-tinta-3">Rótulo · 13 px</dt>
          <dd><span class="label">Opinión</span></dd>
        </div>
      </dl>
    </section>

    <!-- Lectura larga -->
    <section aria-labelledby="lectura">
      <SectionHeading id="lectura" eyebrow="04" title="Texto largo" />
      <p class="mb-8 max-w-2xl text-small text-tinta-2">
        Ancho máximo de 68 caracteres por línea (entre 60 y 75 es lo recomendado para lectura continua), interlineado 1,7 y títulos serif.
      </p>
      <div class="prose-ipdc">
        <p>
          La Constitución de la República del Paraguay de 1992 es generalmente reconocida como la más democrática en la historia del
          país. La Constitución contribuyó a fortalecer la transición a la democracia y a instaurar un régimen de libertades
          públicas en el Paraguay, proceso que se había iniciado en 1989 con la caída de la dictadura militar.
        </p>
        <h2>Requisitos</h2>
        <ol>
          <li>Ser propuesto por al menos dos miembros activos del IPDC.</li>
          <li>Ser egresado de la carrera de abogacía, con al menos 5 años de antigüedad.</li>
        </ol>
        <blockquote>
          <p>“Más vale diez culpables libres que un inocente preso”.</p>
        </blockquote>
        <p>Para más información, escríbanos a <a href="mailto:ipdc.py@gmail.com">ipdc.py@gmail.com</a>.</p>
      </div>
    </section>

    <!-- Botones -->
    <section aria-labelledby="botones">
      <SectionHeading id="botones" eyebrow="05" title="Botones y enlaces" />
      <div class="flex flex-wrap items-center gap-4">
        <Button href="#botones">Requisitos para ser miembro</Button>
        <Button href="#botones" variant="secondary">Ver publicaciones</Button>
        <Button href="#botones" variant="link" arrow>Conocer más</Button>
      </div>
      <div class="mt-6 flex flex-wrap items-center gap-4 rounded-card bg-azul-950 p-6 on-dark">
        <Button href="#botones" variant="inverse">Sobre fondo oscuro</Button>
      </div>
      <p class="mt-4 text-small text-tinta-2">Área táctil mínima de 44–48 px. Probá con la tecla Tab: el foco siempre es visible.</p>
    </section>

    <!-- Documentos -->
    <section aria-labelledby="documentos">
      <SectionHeading id="documentos" eyebrow="06" title="Documentos descargables" />
      <p class="mb-6 max-w-2xl text-small text-tinta-2">
        Peso y cantidad de páginas se calculan automáticamente al publicar. Toda la tarjeta es clickeable, pero para lectores de pantalla
        el enlace es solo el título.
      </p>
      <div class="grid gap-4 lg:grid-cols-2">
        <DocumentCard title="Constitución de la República del Paraguay de 1992" href="/wp-content/uploads/2021/04/constitucion.pdf" docLang="es" />
        <DocumentCard title="Constitución de 1992 en guaraní" description="Edición Decidamos" href="/wp-content/uploads/2021/04/Leiguasu_edicion_Decidamos.pdf" docLang="gn" />
        <DocumentCard title="Enmienda a la Constitución de 1992" href="https://www.bacn.gov.py/ENMIENDA_CONSTITUCIONAL_N_1.pdf" year="2011" />
        <DocumentCard title="Reglamento de Gobierno de 1813" year="1813" available={false} />
      </div>
    </section>

    <!-- Personas -->
    <section aria-labelledby="personas">
      <SectionHeading id="personas" eyebrow="07" title="Autoridades y miembros" />
      <p class="mb-6 max-w-2xl text-small text-tinta-2">
        La foto es opcional. Sin foto se muestran las iniciales; al agregarla en el archivo de datos, aparece en Autoridades y en Miembros a la vez.
      </p>
      <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-5">
        <PersonCard name="Robert Marcial González" role="Presidente" photo={robert} />
        <PersonCard name="Elodia Almirón" role="Vice-Presidenta" />
        <PersonCard name="Manuel Riera" role="Secretario General" />
        <PersonCard name="Laura Whittingslow" role="Tesorera" />
        <PersonCard name="Jorge Seall-Sasiain" memoriam />
      </div>
    </section>

    <!-- Blog y eventos -->
    <section aria-labelledby="tarjetas">
      <SectionHeading id="tarjetas" eyebrow="08" title="Blog y eventos" />
      <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-3">
        <PostCard
          title="Un aplauso para el cirujano del cartismo"
          href="#tarjetas"
          date={new Date('2025-08-10')}
          authors={['Robert Marcial González']}
          category="Opinión"
          excerpt="El revuelo suscitado por la valiente investigación periodística que puso al descubierto que una Senadora al servicio del cartismo, hacía pagar con recursos del erario público la remuneración de dos sobrinas…"
        />
        <PostCard
          title="¿La hará cumplir?"
          href="#tarjetas"
          date={new Date('2025-06-07')}
          authors={['Manuel Riera D.']}
          category="Opinión"
          excerpt="El 14 de febrero de 2024, la senadora Kattya Mabel González Villanueva perdió su investidura."
        />
        <PostCard
          title="Roberto Gargarella en Paraguay: Jornadas de Debate sobre Derecho Constitucional"
          href="#tarjetas"
          date={new Date('2024-11-20')}
          category="Noticias y eventos"
          excerpt="¡No te pierdas las Jornadas de Debate de Derecho Constitucional con Roberto Gargarella!"
        />
      </div>
      <div class="mt-12 max-w-2xl">
        <EventCard
          title="I Congreso Paraguayo de Derecho Constitucional"
          href="#tarjetas"
          startDate={new Date('2021-11-24')}
          endDate={new Date('2021-11-25')}
          location="Asunción"
          modality="Virtual y presencial"
        />
      </div>
    </section>

    <!-- Acordeón y avisos -->
    <section aria-labelledby="acordeon">
      <SectionHeading id="acordeon" eyebrow="09" title="Acordeón y avisos" />
      <div class="grid gap-12 lg:grid-cols-2">
        <div class="border-t border-linea">
          <Accordion title="Congresos, seminarios y charlas" open>
            <p>
              El IPDC organiza y apoya la realización de congresos, seminarios, conferencias y charlas sobre temas variados del
              derecho constitucional, ya sean de derecho constitucional paraguayo, extranjero o comparado.
            </p>
          </Accordion>
          <Accordion title="Cursos">
            <p>El IPDC apoya la organización de cursos con universidades y distintos centros de formación y educación continua.</p>
          </Accordion>
          <Accordion title="Capítulo paraguayo del IIDC">
            <p>El IPDC es el capítulo paraguayo del Instituto Iberoamericano de Derecho Constitucional.</p>
          </Accordion>
        </div>
        <Callout class="self-start">
          <p>
            <strong>
              Las opiniones y puntos de vista expresados en este blog son exclusivamente responsabilidad de los autores y no
              representan de ninguna manera la posición oficial del Instituto Paraguayo de Derecho Constitucional, ni la de su
              Comisión Directiva.
            </strong>
          </p>
        </Callout>
      </div>
    </section>

    <!-- Navegación -->
    <section aria-labelledby="navegacion">
      <SectionHeading id="navegacion" eyebrow="10" title="Paginación y newsletter" />
      <Pagination current={2} total={3} url={(n) => `#p${n}`} />
      <div class="mt-14 max-w-2xl rounded-card border border-linea bg-white p-6 sm:p-8">
        <Newsletter lang="es" id="demo-newsletter" />
      </div>
    </section>
  </div>

  <!-- Cabecera con foto -->
  <section aria-label="Cabecera con fotografía">
    <PageHeader
      eyebrow="Conocé la Constitución"
      title="Constitución de 1992"
      lead="La Constitución de la República del Paraguay de 1992 es generalmente reconocida como la más democrática en la historia del país."
      image={panteon}
      imageAlt="Cúpula del Panteón Nacional de los Héroes, en Asunción, al anochecer"
    />
  </section>
</BaseLayout>
