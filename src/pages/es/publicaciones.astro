---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import DocumentCard from '@/components/DocumentCard.astro';
import { getPage } from '@/lib/content';
import tapa from '@/assets/publicaciones/anuario-la-ley.jpg';

const page = await getPage('publicaciones');
const compra = await getPage('publicaciones-compra');
const { Content } = await render(page);
const { Content: Compra } = await render(compra);
const anuarios = (await getCollection('anuarios')).sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <PageHeader
    eyebrow={page.data.title}
    title={page.data.lead ?? page.data.title}
    breadcrumbs={[{ label: 'Inicio', href: '/es/' }, { label: page.data.title }]}
  />

  <div class="container-page grid gap-12 py-16 sm:py-20 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <div class="prose-ipdc"><Content /></div>
    </div>
    <figure class="lg:col-span-5">
      <Image
        src={tapa}
        alt="Anuario Paraguayo de Derecho Constitucional 2020, presentado por el Instituto Paraguayo de Derecho Constitucional y La Ley"
        widths={[480, 720, 1024]}
        sizes="(min-width: 1024px) 460px, 100vw"
        class="w-full rounded-card shadow-card"
      />
    </figure>
  </div>

  <section class="container-page pb-20 sm:pb-24" aria-labelledby="ediciones">
    <SectionHeading id="ediciones" title="Ediciones publicadas" />
    <p class="mb-8 max-w-(--container-prose) text-tinta-2">A continuación, se pueden consultar los índices completos de las ediciones publicadas:</p>
    <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        anuarios.map((a) => (
          <li>
            <DocumentCard title={a.data.title} description="Índice completo" href={a.data.indexPdf} />
          </li>
        ))
      }
    </ul>
    <div class="prose-ipdc mt-10"><Compra /></div>
  </section>
</BaseLayout>
