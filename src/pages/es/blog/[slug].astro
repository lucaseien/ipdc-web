---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Callout from '@/components/Callout.astro';
import Icon from '@/components/Icon.astro';
import { formatDate } from '@/lib/format';
import { categories, getPage, getPosts, postUrl, slugOf, type Post } from '@/lib/content';
import { site } from '@/config/site';

export async function getStaticPaths() {
  const posts = await getPosts('es');
  return posts.map((post, i) => ({
    params: { slug: slugOf(post) },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props as { post: Post; newer?: Post; older?: Post };
const d = post.data;
const { Content } = await render(post);
const { Content: Descargo } = await render(await getPage('blog-descargo'));
const words = (post.body ?? '').split(/\s+/).length;
const minutes = Math.max(1, Math.round(words / 220));
const isoDate = d.date.toISOString().slice(0, 10);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: isoDate,
  inLanguage: 'es',
  author: d.authors.length ? d.authors.map((name) => ({ '@type': 'Person', name })) : { '@id': `${site.url}/#organization` },
  publisher: { '@id': `${site.url}/#organization` },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<BaseLayout title={d.title} description={d.description} type="article" image={d.cover?.src} preloadItalic>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <meta slot="head" property="article:published_time" content={isoDate} />

  <article>
    <header class="border-b border-linea bg-papel-2">
      <div class="container-page pt-8 pb-10 sm:pt-12 sm:pb-14">
        <Breadcrumbs items={[{ label: 'Inicio', href: '/es/' }, { label: 'Blog', href: '/es/blog/' }, { label: d.title }]} />
        <div class="mx-auto mt-10 max-w-(--container-prose)">
          <p class="label">
            <a href={`/es/blog/categoria/${d.category}/`} class="text-rojo-700 no-underline hover:underline">{categories[d.category]}</a>
          </p>
          <h1 class="mt-3 text-h1 font-medium">{d.title}</h1>
          <span class="filete mt-6" aria-hidden="true"></span>
          <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-3 text-small text-tinta-2">
            {
              d.authorPhoto && (
                <Image src={d.authorPhoto} alt="" width={56} height={56} densities={[1, 2]} class="size-14 rounded-full bg-white object-cover object-top ring-2 ring-white" />
              )
            }
            <div>
              {d.authors.length > 0 && <p>Por <span class="font-semibold text-tinta">{d.authors.join(' y ')}</span></p>}
              <p>
                <time datetime={isoDate}>{formatDate(d.date)}</time>
                <span aria-hidden="true"> · </span>
                {minutes} min de lectura
              </p>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="container-page py-12 sm:py-16">
      <div class="prose-ipdc mx-auto [&_.footnotes]:mt-14 [&_.footnotes]:border-t [&_.footnotes]:border-linea [&_.footnotes]:pt-6 [&_.footnotes]:text-small">
        <Content />
      </div>
      <div class="mx-auto mt-14 max-w-(--container-prose)">
        <Callout><Descargo /></Callout>
      </div>
    </div>
  </article>

  <nav aria-label="Más entradas" class="container-page pb-20 sm:pb-24">
    <div class="mx-auto grid max-w-(--container-prose) gap-4 border-t border-linea pt-8 sm:grid-cols-2">
      {
        older ? (
          <a href={postUrl(older)} class="group rounded-card p-3 no-underline hover:bg-white">
            <span class="flex items-center gap-2 text-small text-tinta-3"><Icon name="arrow-left" class="size-4" /> Anterior</span>
            <span class="mt-1 block font-serif text-[1.125rem] leading-snug font-semibold text-azul-900 group-hover:underline">{older.data.title}</span>
          </a>
        ) : <span />
      }
      {
        newer && (
          <a href={postUrl(newer)} class="group rounded-card p-3 text-right no-underline hover:bg-white">
            <span class="flex items-center justify-end gap-2 text-small text-tinta-3">Siguiente <Icon name="arrow-right" class="size-4" /></span>
            <span class="mt-1 block font-serif text-[1.125rem] leading-snug font-semibold text-azul-900 group-hover:underline">{newer.data.title}</span>
          </a>
        )
      }
    </div>
  </nav>
</BaseLayout>
