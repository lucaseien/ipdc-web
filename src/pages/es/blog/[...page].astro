---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogIndex from '@/components/BlogIndex.astro';
import { getPage, getPosts, POSTS_PER_PAGE, type Post } from '@/lib/content';

export async function getStaticPaths() {
  const posts = await getPosts('es');
  const total = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
  return Array.from({ length: total }, (_, i) => ({
    params: { page: i === 0 ? undefined : `pagina/${i + 1}` },
    props: { posts: posts.slice(i * POSTS_PER_PAGE, (i + 1) * POSTS_PER_PAGE), current: i + 1, total },
  }));
}

const { posts, current, total } = Astro.props as { posts: Post[]; current: number; total: number };
const page = await getPage('blog');
---

<BaseLayout title={current > 1 ? `${page.data.title} — Página ${current}` : page.data.title} description={page.data.description}>
  <BlogIndex posts={posts} current={current} total={total} />
</BaseLayout>
