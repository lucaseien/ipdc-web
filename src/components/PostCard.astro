---
import Icon from './Icon.astro';
import { formatDate } from '@/lib/format';
import { t, type Lang } from '@/i18n/ui';

interface Props {
  title: string;
  href: string;
  date: Date;
  authors?: string[];
  category?: string;
  excerpt?: string;
  lang?: Lang;
  headingLevel?: 'h2' | 'h3';
}

const { title, href, date, authors = [], category, excerpt, lang = 'es', headingLevel: H = 'h3' } = Astro.props;
---

<article class="group relative flex h-full flex-col border-t-2 border-azul-900 pt-5">
  <p class="label flex items-center gap-2">
    {category && <span>{category}</span>}
    {category && <span aria-hidden="true" class="text-linea">|</span>}
    <time datetime={date.toISOString().slice(0, 10)} class="text-tinta-3">{formatDate(date, lang)}</time>
  </p>
  <H class="mt-3 font-serif text-h3 font-semibold text-azul-900">
    <a href={href} class="no-underline after:absolute after:inset-0 group-hover:underline">{title}</a>
  </H>
  {excerpt && <p class="mt-3 line-clamp-3 text-tinta-2">{excerpt}</p>}
  <div class="mt-auto flex items-center justify-between gap-4 pt-5">
    {authors.length > 0 && <p class="text-small text-tinta-2">{t(lang, 'post.by')} <span class="font-semibold text-tinta">{authors.join(' y ')}</span></p>}
    <Icon name="arrow-right" class="ml-auto size-5 text-rojo-600 transition-transform group-hover:translate-x-1" />
  </div>
</article>
