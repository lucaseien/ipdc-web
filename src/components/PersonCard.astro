---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { initials } from '@/lib/format';
import { t, type Lang } from '@/i18n/ui';

interface Props {
  name: string;
  role?: string;
  /** Foto opcional; sin foto se muestran las iniciales */
  photo?: ImageMetadata;
  memoriam?: boolean;
  lang?: Lang;
  size?: 'md' | 'sm';
}

const { name, role, photo, memoriam = false, lang = 'es', size = 'md' } = Astro.props;
---

<article class="group">
  <div
    class:list={[
      'relative overflow-hidden rounded-card',
      size === 'md' ? 'aspect-[4/5]' : 'aspect-square',
      photo ? 'bg-azul-100' : 'bg-gradient-to-br from-azul-50 to-azul-100 ring-1 ring-azul-200/60 ring-inset',
    ]}
  >
    {
      photo ? (
        <Image src={photo} alt="" widths={[240, 360, 480]} sizes="(min-width: 1024px) 220px, 45vw" class:list={['size-full object-cover', memoriam && 'grayscale']} />
      ) : (
        <span
          aria-hidden="true"
          class:list={['absolute inset-0 flex items-center justify-center font-serif font-medium text-azul-700/80', size === 'md' ? 'text-[2.75rem]' : 'text-[1.5rem] sm:text-[2rem]']}
        >
          {initials(name)}
        </span>
      )
    }
    <span class="absolute inset-x-0 bottom-0 flex h-1" aria-hidden="true">
      <span class="flex-1 bg-celeste-600" /><span class="flex-1 bg-azul-700" />
    </span>
  </div>
  <h3 class:list={['mt-3 font-serif leading-snug font-semibold text-azul-900', size === 'md' ? 'text-[1.1875rem]' : 'text-[0.9375rem] sm:text-[1.0625rem]']}>
    {name}
  </h3>
  {role && <p class="mt-0.5 text-small text-tinta-2">{role}</p>}
  {memoriam && size === 'md' && <p class="label mt-1 text-tinta-3">{t(lang, 'person.memoriam')}</p>}
</article>
