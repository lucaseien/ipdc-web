---
interface Props {
  title: string;
  eyebrow?: string;
  id?: string;
  as?: 'h2' | 'h3';
}
const { title, eyebrow, id, as: H = 'h2' } = Astro.props;
---

<div class="mb-8 sm:mb-10">
  {eyebrow && <p class="label mb-2">{eyebrow}</p>}
  <H id={id} class="text-h2 font-medium">{title}</H>
  <span class="filete mt-4" aria-hidden="true"></span>
</div>
