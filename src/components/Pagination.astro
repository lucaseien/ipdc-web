---
import Icon from './Icon.astro';
import { t, type Lang } from '@/i18n/ui';

interface Props {
  current: number;
  total: number;
  /** Construye la URL de la página n */
  url: (n: number) => string;
  lang?: Lang;
}
const { current, total, url, lang = 'es' } = Astro.props;
const pages = Array.from({ length: total }, (_, i) => i + 1);
---

{
  total > 1 && (
    <nav aria-label={t(lang, 'a11y.pagination')} class="mt-14 flex items-center justify-between gap-4 border-t border-linea pt-6">
      {current > 1 ? (
        <a href={url(current - 1)} class="inline-flex min-h-11 items-center gap-2 font-semibold no-underline" rel="prev">
          <Icon name="arrow-left" class="size-4" /> {t(lang, 'post.prev')}
        </a>
      ) : <span />}
      <ol class="hidden gap-1 sm:flex">
        {pages.map((n) => (
          <li>
            <a
              href={url(n)}
              class="flex size-11 items-center justify-center rounded-card font-semibold no-underline aria-[current=page]:bg-azul-700 aria-[current=page]:text-white hover:bg-azul-50"
              aria-current={n === current ? 'page' : undefined}
            >
              <span class="sr-only">{t(lang, 'post.page')} </span>{n}
            </a>
          </li>
        ))}
      </ol>
      {current < total ? (
        <a href={url(current + 1)} class="inline-flex min-h-11 items-center gap-2 font-semibold no-underline" rel="next">
          {t(lang, 'post.next')} <Icon name="arrow-right" class="size-4" />
        </a>
      ) : <span />}
    </nav>
  )
}
