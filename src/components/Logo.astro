---
import { Image } from 'astro:assets';
import logo from '@/assets/brand/logo-idsp.png';
import { site } from '@/config/site';

interface Props {
  /** `full`: sello + nombre completo; `mark`: solo el sello */
  variant?: 'full' | 'mark';
  /** Tono del nombre: sobre fondo claro u oscuro */
  tone?: 'light' | 'dark';
  class?: string;
}

const { variant = 'full', tone = 'light', class: className } = Astro.props;
// El sello es decorativo: el nombre accesible lo da el enlace o el texto que lo acompaña.
---

<span class:list={['inline-flex items-center gap-3', className]}>
  <Image src={logo} alt="" width={56} height={56} densities={[1, 2, 3]} loading="eager" class="block size-12 shrink-0 sm:size-14" />
  {
    variant === 'full' && (
      <span
        class:list={[
          'font-serif leading-[1.1] font-semibold tracking-[-0.005em]',
          tone === 'light' ? 'text-azul-900' : 'text-white',
        ]}
      >
        <span class="block text-[1.0625rem] sm:hidden">{site.shortName}</span>
        <span class="hidden max-w-[17rem] text-[1.0625rem] sm:block">{site.name}</span>
      </span>
    )
  }
</span>
