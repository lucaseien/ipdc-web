---
import logoSvg from '@/assets/brand/logo-ipdc.svg?raw';
import { site } from '@/config/site';

interface Props {
  /** `full`: isotipo + nombre completo; `mark`: solo el isotipo */
  variant?: 'full' | 'mark';
  /** Tono del nombre: sobre fondo claro u oscuro */
  tone?: 'light' | 'dark';
  class?: string;
}

const { variant = 'full', tone = 'light', class: className } = Astro.props;
// El isotipo es decorativo: el nombre accesible lo da el enlace o el texto que lo acompaña.
const mark = logoSvg.replace('<svg ', '<svg aria-hidden="true" focusable="false" class="size-full" ').replace(/<title>.*?<\/title>/, '');
---

<span class:list={['inline-flex items-center gap-3', className]}>
  <span
    class:list={['block size-11 shrink-0 sm:size-12', tone === 'dark' && 'rounded-full bg-white p-1']}
    set:html={mark}
  />
  {
    variant === 'full' && (
      <span
        class:list={[
          'font-serif leading-[1.1] font-semibold tracking-[-0.005em]',
          tone === 'light' ? 'text-azul-900' : 'text-white',
        ]}
      >
        <span class="block text-[1.0625rem] sm:hidden">{site.shortName}</span>
        <span class="hidden max-w-[17rem] text-[1.0625rem] sm:block">{site.name}</span>
      </span>
    )
  }
</span>
