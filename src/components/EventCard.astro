---
import Icon from './Icon.astro';
import { dateParts, formatDate } from '@/lib/format';
import type { Lang } from '@/i18n/ui';

interface Props {
  title: string;
  href: string;
  startDate: Date;
  endDate?: Date;
  location?: string;
  modality?: string;
  lang?: Lang;
  headingLevel?: 'h2' | 'h3';
}

const { title, href, startDate, endDate, location, modality, lang = 'es', headingLevel: H = 'h3' } = Astro.props;
const start = dateParts(startDate, lang);
const end = endDate ? dateParts(endDate, lang) : undefined;
const sameMonth = !!end && end.month === start.month && end.year === start.year;
const range = !endDate
  ? formatDate(startDate, lang)
  : sameMonth
    ? `${start.day} – ${formatDate(endDate, lang)}`
    : `${formatDate(startDate, lang)} – ${formatDate(endDate, lang)}`;
---

<article class="group relative flex gap-5 rounded-card border border-linea bg-white p-5 shadow-card transition-shadow hover:shadow-card-hover">
  <div class="flex w-20 shrink-0 flex-col items-center justify-center rounded-card bg-azul-900 py-3 text-white" aria-hidden="true">
    <span class:list={['font-serif leading-none font-semibold whitespace-nowrap', sameMonth ? 'text-[1.375rem]' : 'text-[1.75rem]']}>{start.day}{sameMonth && `–${end!.day}`}</span>
    <span class="label mt-1 text-azul-200">{start.month}</span>
    <span class="text-label text-azul-200">{start.year}</span>
  </div>
  <div class="min-w-0">
    <H class="font-serif text-h3 font-semibold text-azul-900">
      <a href={href} class="no-underline after:absolute after:inset-0 group-hover:underline">{title}</a>
    </H>
    <p class="mt-2 flex items-center gap-2 text-small text-tinta-2">
      <Icon name="calendar" class="size-4 text-rojo-600" />
      <span>{range}</span>
    </p>
    {
      location && (
        <p class="mt-1 flex items-center gap-2 text-small text-tinta-2">
          <Icon name="pin" class="size-4 text-rojo-600" />
          <span>{location}{modality && ` · ${modality}`}</span>
        </p>
      )
    }
  </div>
</article>
